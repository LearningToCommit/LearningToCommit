# Copy to .env and fill in. Variables already exported in your shell take precedence.

# Used by the agent (Claude Code via the Claude Agent SDK) and by the pairwise judge /
# data-construction scripts (Anthropic Messages API).
ANTHROPIC_API_KEY=
# Optional: only set this if you go through a proxy or gateway.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model for all agent phases (--model on the CLI overrides it).
LTC_MODEL=claude-sonnet-4-6

# --- Optional knobs ---
# LTC_MAX_TOKENS=32768          # max output tokens per LLM call
# LTC_THINKING=disabled         # "disabled" (as in the paper) or "adaptive"
# LTC_CONCURRENCY=4             # test tasks solved in parallel
# LTC_JUDGE_MODEL=              # pairwise judge, stage 1 (analysis); defaults to LTC_MODEL
# LTC_JUDGE_EXTRACTOR_MODEL=    # pairwise judge, stage 2 (JSON extraction); defaults to LTC_JUDGE_MODEL
# LTC_SANDBOX_ROOT=             # parent dir of per-phase working dirs (default: <system temp>/ltc_sandbox)
# LTC_SANDBOX_KEEP=1            # keep per-phase working dirs after each phase (debugging)
# LTC_CLAUDE_CONFIG_DIR=        # private Claude Code config dir (default: <LTC_SANDBOX_ROOT>/claude_config)
